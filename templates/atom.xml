{{/*
  atom.xml - Atom feed template.
  Uses text/template to preserve XML whitespace/indentation.
*/}}

{{- define "atom"}}<?xml version="1.0" encoding="UTF-8"?>
<feed xml:lang="en" xmlns="http://www.w3.org/2005/Atom">
  <title type="text">{{xmlEscape .Site.Title}}</title>
  <subtitle type="text">{{xmlEscape .Site.Slogan}}</subtitle>
  <id>{{.FeedURL}}</id>
  <link rel="self" type="application/atom+xml" href="{{.FeedURL}}"/>
  <link rel="alternate" type="text/html" href="{{.Site.URL}}"/>
{{- range .Site.Authors}}
  <author><name>{{xmlEscape .}}</name></author>
{{- end}}
{{- if .Site.Copyright}}
  <rights>{{xmlEscape .Site.Copyright}}</rights>
{{- end}}
{{- if .Site.IconHref}}
  <icon>{{urlJoin .Site.URL .Site.IconHref}}</icon>
{{- end}}
{{- if .Site.LogoHref}}
  <logo>{{urlJoin .Site.URL .Site.LogoHref}}</logo>
{{- end}}
  <generator uri="https://github.com/tim-janik/iris/">Iris</generator>
{{- range .Items}}
  <entry>
    <id>{{xmlEscape .URL}}</id>
    <title>{{xmlEscape .Title}}</title>
    <updated>{{formatDate .ModifiedDate "iso8601"}}</updated>
    <published>{{formatDate .PublishedDate "iso8601"}}</published>
    <link rel="alternate" href="{{xmlEscape .LinkHref}}"/>
{{- range .Keywords}}
    <category term="{{xmlEscape .}}"/>
{{- end}}
{{- if or .Options.WithDescription (not .Options.WithContent)}}
    <summary>{{xmlEscape .Excerpt}}</summary>
{{- end}}
{{- if .Options.WithContent}}
    <content type="html" xml:base="{{xmlEscape .URL}}">{{xmlEscape .FullContent}}</content>
{{- end}}
  </entry>
{{- end}}
  <updated>{{formatDate .LastBuild "iso8601"}}</updated>
</feed>
{{- end}}
