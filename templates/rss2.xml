{{/*
  rss2.xml - RSS 2.0 feed template.
  Uses text/template to preserve XML whitespace/indentation.
*/}}

{{- define "rss2"}}<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <language>en</language>
    <title>{{xmlEscape .Site.Title}}</title>
    <description>{{xmlEscape .Site.Slogan}}</description>
    <link>{{urlJoin .Site.URL ""}}</link>
    <atom:link rel="self" type="application/rss+xml" href="{{.FeedURL}}"/>
    <ttl>60</ttl>
{{- range .Site.Authors}}
    <dc:creator>{{xmlEscape .}}</dc:creator>
{{- end}}
{{- if .Site.Copyright}}
    <copyright>{{xmlEscape .Site.Copyright}}</copyright>
{{- end}}
{{- if or .Site.LogoHref .Site.IconHref}}
    <image>
      <title>{{.Site.Title}}</title>
      <url>{{urlJoin .Site.URL (or .Site.LogoHref .Site.IconHref)}}</url>
      <link>{{urlJoin .Site.URL ""}}</link>
    </image>
{{- end}}
    <generator>Iris - https://github.com/tim-janik/iris/</generator>
{{- range .Items}}
    <item>
      <title>{{xmlEscape .Title}}</title>
      <link>{{xmlEscape .URL}}</link>
      <guid isPermaLink="true">{{xmlEscape .URL}}</guid>
      <pubDate>{{formatDate .PublishedDate "rfc822z"}}</pubDate>
      <source url="{{$.FeedURL}}">{{xmlEscape .SiteTitle}}</source>
{{- range .Keywords}}
      <category>{{xmlEscape .}}</category>
{{- end}}
{{- if or .Options.WithDescription (not .Options.WithContent)}}
      <description>{{xmlEscape .Excerpt}}</description>
{{- end}}
{{- if .Options.WithContent}}
      <content:encoded>{{xmlEscape .FullContent}}</content:encoded>
{{- end}}
    </item>
{{- end}}
    <lastBuildDate>{{formatDate .LastBuild "rfc822z"}}</lastBuildDate>
  </channel>
</rss>
{{- end}}
